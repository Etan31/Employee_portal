# Copy these values into the ROOT .env file. Replace the deleted project's values.
# Public browser configuration (Supabase project Connect dialog).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server configuration. Keep this key private and never prefix it with VITE_.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
